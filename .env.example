NODE_ENV=development
HOST=localhost
PORT=10000

DB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars
JWT_ACCESS_EXPIRED=30d

FRONT_END_URL=http://localhost:5173
EMAIL=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# CSRF
CSRF_SECRET=your_csrf_secret_min_32_chars

# VNPAY
VNP_TMN_CODE=your_vnpay_tmn_code
VNP_HASH_SECRET=your_vnpay_hash_secret
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:10000/api/payment/vnpay/return

# ZALOPAY
ZALOPAY_APP_ID=2553
ZALOPAY_KEY1=your_zalopay_key1
ZALOPAY_KEY2=your_zalopay_key2
ZALOPAY_ENDPOINT=https://sb-openapi.zalopay.vn/v2/create
ZALOPAY_CALLBACK_URL=http://localhost:10000/api/payment/zalopay/callback

# VIETQR
BANK_BIN=970423
BANK_ACCOUNT_NUMBER=00000847022
